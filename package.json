{
  "name": "@hongshancapital/eslint-config-hongshan",
  "version": "2.3.2",
  "description": "Unified ESLint, Oxlint, and formatter configuration",
  "license": "UNLICENSED",
  "author": "Gao Sun",
  "repository": "https://github.com/hongshancapital/eslint-config-hongshan.git",
  "files": [
    "dist",
    "prettier.json"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./globs": {
      "types": "./dist/globs.d.mts",
      "import": "./dist/globs.mjs"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.mts",
      "import": "./dist/oxfmt.mjs"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.mts",
      "import": "./dist/oxlint.mjs"
    },
    "./prettier.json": "./prettier.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm build && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint .",
    "prepublishOnly": "pnpm check",
    "release": "pnpm publish --dry-run && pnpm publish",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "typescript-eslint": "^8.65.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": ">=5.4.5"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
