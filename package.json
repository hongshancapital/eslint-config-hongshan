{
  "name": "@hongshancapital/eslint-config-hongshan",
  "version": "2.0.0",
  "type": "module",
  "repository": "https://github.com/hongshancapital/eslint-config-hongshan.git",
  "author": "Gao Sun",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    },
    "./prettier.json": "./prettier.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "prettier.json",
    "react.js",
    "react.d.ts"
  ],
  "private": false,
  "scripts": {
    "build": "tsdown && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.7.4",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.59.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "typescript": ">=5.4.5"
  },
  "prettier": "./prettier.json",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
